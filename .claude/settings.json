{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__.*(?:[Vv]ercel|[Ss]tripe|[Aa]utumn).*__(?!(?:get_(?!access_to_|or_create_|project_deletion_)|list_|search_|retrieve_|fetch_|count_|aggregate_|filter_|read_|check_|web_fetch_|wait_for_))",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-mcp.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
